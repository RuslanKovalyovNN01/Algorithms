#include <algorithm>
#include <iostream>
#include <vector>

const int INF = 1e9;

class SegmentTree {
    int tree_size = 1;
    std::vector<int> tree;
public:
    SegmentTree(const std::vector<int> &v) {
        const int input_vector_size = v.size();
        while(tree_size < input_vector_size){
            tree_size *= 2;
        }
        tree.resize(2 * tree_size, -INF);
        for(int i = 0; i < input_vector_size; i++){
            tree[tree_size + i] = v[i];
        }
        for(int i = tree_size - 1; i>0;i--){
            tree[i] = std::max(tree[2 * i], tree[2 * i + 1]);
        }   
    }
    int get(int index){
        return tree[tree_size + i];
    }
    int set(int index, int value){
        int node = tree_size + index;
        tree[node] = value;
        node /= 2;
        while(node > 0) {
            tree[node] = std::max(tree[2 * node], tree[2 * node + 1]);
            node /= 2;
        }
    }
    int max(int left, int right){
        return _max(1,0,tree_size,left_bound, right_bound);
    }
private:
    int _max(int node, int start, int segment_size, int left_bound, int right_bound){
        if(start + segment_size <= left_bound || right_bound <= start){
            return -INF;
        }
        if(left_bound <= start && start+segment_size <= right_bound){
            return tree[node];
        }
    }
};